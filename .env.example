# Token do Bot gerado no @BotFather
SYSADMIN_BOT_TOKEN=seu_telegram_bot_token_aqui
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui

# Chave de API da DeepSeek (ou compatível OpenAI)
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui

# Seu ID numérico no Telegram (obtenha via @userinfobot)
ALLOWED_USER_ID=1234567890

# IP do Nó Proxmox VE
PROXMOX_HOST=192.168.30.250

# Log de auditoria local (JSON Lines)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=/app/logs
# No Compose o nome do arquivo e definido por servico
AUDIT_LOG_FILE=audit.jsonl
AUDIT_LOG_RETENTION_DAYS=0
AUDIT_LOG_MAX_FIELD_CHARS=20000
AUDIT_LOG_CAPTURE_OUTPUT=true
AUDIT_LOG_CAPTURE_DENIED=false
AUDIT_LOG_REDACT=true
